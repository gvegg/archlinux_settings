#!/bin/sh
exec tail -n +3 $0

# ============================================================
# Ручные пункты меню GRUB для темы noto_menu.
#
# ЭТО ШАБЛОН. Рабочий /etc/grub.d/40_custom генерирует configure.sh:
# он подставляет UUID корня и /boot, тип ФС и номер Windows Boot Manager.
#   bash configure.sh          # вручную
#   sudo bash apply.sh         # вызовет configure.sh автоматически
#
# Пункты статичные. Если поставить ДРУГОЕ ядро (linux-lts и т.п.) —
# добавь сюда аналогичный menuentry с /vmlinuz-lts и /initramfs-lts.img.
#
# Тишина при загрузке: параметры ядра заданы ЗДЕСЬ, а не в
# GRUB_CMDLINE_LINUX_DEFAULT (ручной menuentry не подставляет linux_cmdline).
# ============================================================

menuentry 'Arch Linux' {
	load_video
	set gfxpayload=keep
	insmod gzio
	insmod part_gpt
	insmod part_msdos
	insmod @BOOT_INSMOD@
	search --no-floppy --fs-uuid --set=root @BOOT_UUID@
	linux	@KERNEL_PREFIX@/vmlinuz-linux root=UUID=@ROOT_UUID@ rw quiet loglevel=0 systemd.show_status=no udev.log_level=0
	initrd	@KERNEL_PREFIX@/initramfs-linux.img
}

# BootNext: прошивка сама загрузит Windows следующим шагом (Boot0001 в NVRAM).
# Содержимое диска Windows не затрагивается — меняется только переменная прошивки.
menuentry 'Windows' {
	if bootnext @WINDOWS_BOOTNUM@; then
		reboot
	fi
}

menuentry 'UEFI BIOS' {
	fwsetup
}
